<?xml version="1.0" encoding="utf-8"?>
<!-- RMXP-Android-Ports: cada control es hijo directo de este layout (pantalla completa),
     así cada uno se puede mover, ocultar y cambiar de tamaño por separado. -->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/gamepad_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">

    <com.hatkid.mkxpz.gamepad.GamepadDPad
        android:id="@+id/dpad"
        android:layout_width="@dimen/_110sdp"
        android:layout_height="@dimen/_110sdp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:clickable="false"
        android:focusable="false"
        app:bgDrawable="@drawable/gamepad_dpad_back"
        app:fgDrawable="@drawable/gamepad_dpad_front" />

    <com.hatkid.mkxpz.gamepad.GamepadButton
        android:id="@+id/button_L"
        android:layout_width="@dimen/_38sdp"
        android:layout_height="@dimen/_38sdp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_25sdp"
        app:bgDrawable="@drawable/gamepad_button_circle"
        tools:ignore="ImageContrastCheck" />

    <com.hatkid.mkxpz.gamepad.GamepadButton
        android:id="@+id/button_R"
        android:layout_width="@dimen/_38sdp"
        android:layout_height="@dimen/_38sdp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_25sdp"
        app:bgDrawable="@drawable/gamepad_button_circle"
        tools:ignore="ImageContrastCheck" />

    <com.hatkid.mkxpz.gamepad.GamepadButton
        android:id="@+id/button_A"
        android:layout_width="@dimen/_38sdp"
        android:layout_height="@dimen/_38sdp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/_96sdp"
        android:layout_marginBottom="@dimen/_12sdp"
        app:bgDrawable="@drawable/gamepad_button_circle"
        tools:ignore="ImageContrastCheck" />

    <com.hatkid.mkxpz.gamepad.GamepadButton
        android:id="@+id/button_B"
        android:layout_width="@dimen/_38sdp"
        android:layout_height="@dimen/_38sdp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/_54sdp"
        android:layout_marginBottom="@dimen/_12sdp"
        app:bgDrawable="@drawable/gamepad_button_circle"
        tools:ignore="ImageContrastCheck" />

    <com.hatkid.mkxpz.gamepad.GamepadButton
        android:id="@+id/button_C"
        android:layout_width="@dimen/_38sdp"
        android:layout_height="@dimen/_38sdp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_12sdp"
        app:bgDrawable="@drawable/gamepad_button_circle"
        tools:ignore="ImageContrastCheck" />

    <com.hatkid.mkxpz.gamepad.GamepadButton
        android:id="@+id/button_X"
        android:layout_width="@dimen/_38sdp"
        android:layout_height="@dimen/_38sdp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/_96sdp"
        android:layout_marginBottom="@dimen/_54sdp"
        app:bgDrawable="@drawable/gamepad_button_circle"
        tools:ignore="ImageContrastCheck" />

    <com.hatkid.mkxpz.gamepad.GamepadButton
        android:id="@+id/button_Y"
        android:layout_width="@dimen/_38sdp"
        android:layout_height="@dimen/_38sdp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/_54sdp"
        android:layout_marginBottom="@dimen/_54sdp"
        app:bgDrawable="@drawable/gamepad_button_circle"
        tools:ignore="ImageContrastCheck" />

    <com.hatkid.mkxpz.gamepad.GamepadButton
        android:id="@+id/button_Z"
        android:layout_width="@dimen/_38sdp"
        android:layout_height="@dimen/_38sdp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_54sdp"
        app:bgDrawable="@drawable/gamepad_button_circle"
        tools:ignore="ImageContrastCheck" />

    <com.hatkid.mkxpz.gamepad.GamepadButton
        android:id="@+id/button_ENTER"
        android:layout_width="@dimen/_44sdp"
        android:layout_height="@dimen/_22sdp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_98sdp"
        app:bgDrawable="@drawable/gamepad_button_square"
        tools:ignore="ImageContrastCheck" />

    <com.hatkid.mkxpz.gamepad.GamepadButton
        android:id="@+id/button_ESC"
        android:layout_width="@dimen/_44sdp"
        android:layout_height="@dimen/_22sdp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/_62sdp"
        android:layout_marginBottom="@dimen/_98sdp"
        app:bgDrawable="@drawable/gamepad_button_square"
        tools:ignore="ImageContrastCheck" />

    <com.hatkid.mkxpz.gamepad.GamepadButton
        android:id="@+id/button_ALT"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_20sdp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="@dimen/_10sdp"
        app:bgDrawable="@drawable/gamepad_button_square"
        tools:ignore="ImageContrastCheck" />

    <com.hatkid.mkxpz.gamepad.GamepadButton
        android:id="@+id/button_CTRL"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_20sdp"
        android:layout_alignParentBottom="true"
        android:layout_toStartOf="@id/button_ALT"
        android:layout_marginBottom="@dimen/_10sdp"
        android:layout_marginStart="@dimen/_4sdp"
        android:layout_marginEnd="@dimen/_4sdp"
        app:bgDrawable="@drawable/gamepad_button_square"
        tools:ignore="ImageContrastCheck" />

    <com.hatkid.mkxpz.gamepad.GamepadButton
        android:id="@+id/button_SHIFT"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_20sdp"
        android:layout_alignParentBottom="true"
        android:layout_toEndOf="@id/button_ALT"
        android:layout_marginBottom="@dimen/_10sdp"
        android:layout_marginStart="@dimen/_4sdp"
        android:layout_marginEnd="@dimen/_4sdp"
        app:bgDrawable="@drawable/gamepad_button_square"
        tools:ignore="ImageContrastCheck" />
</RelativeLayout>
