<?xml version="1.0" encoding="utf-8"?>
<!-- Botones redondos sobre el juego (turbo y menú). "activated" = turbo encendido -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="oval"><solid android:color="@color/rmxp_ambar" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval"><solid android:color="@color/rmxp_musgo" /></shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/rmxp_tinta" />
            <stroke android:width="1dp" android:color="@color/rmxp_musgo" />
        </shape>
    </item>
</selector>
