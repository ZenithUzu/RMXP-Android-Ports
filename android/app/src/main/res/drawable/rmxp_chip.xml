<?xml version="1.0" encoding="utf-8"?>
<!-- Opción elegible (filtro, pantalla, Hz): ámbar cuando está elegida -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/rmxp_ambar" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/rmxp_pizarra" />
            <stroke android:width="2dp" android:color="@color/rmxp_niebla" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/rmxp_pizarra" />
            <stroke android:width="1dp" android:color="@color/rmxp_musgo" />
        </shape>
    </item>
</selector>
